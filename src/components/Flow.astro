---
interface Step {
  label: string;
  note?: string;
}

interface Props {
  title: string;
  description: string;
  caption: string;
  steps: Step[];
}

const { title, description, caption, steps } = Astro.props;
const boxH = 52;
const gap = 28;
const width = 320;
const height = steps.length * (boxH + gap) - gap + 4;
const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<figure class="diagram">
  <svg
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-labelledby={`${slug}-title ${slug}-desc`}
  >
    <title id={`${slug}-title`}>{title}</title>
    <desc id={`${slug}-desc`}>{description}</desc>
    {
      steps.map((step, i) => {
        const y = i * (boxH + gap);
        return (
          <g>
            <rect x="20" y={y} width="280" height={boxH} fill="#f6f3ee" stroke="#1c1916" />
            <text
              x="160"
              y={y + (step.note ? 22 : 32)}
              text-anchor="middle"
              fill="#1c1916"
              font-size="15"
              font-family="Georgia, Palatino, serif"
            >
              {step.label}
            </text>
            {step.note && (
              <text
                x="160"
                y={y + 40}
                text-anchor="middle"
                fill="#5c564e"
                font-size="12"
                font-family="Georgia, Palatino, serif"
              >
                {step.note}
              </text>
            )}
            {i < steps.length - 1 && (
              <g>
                <path d={`M160 ${y + boxH} V${y + boxH + gap - 7}`} stroke="#1c1916" fill="none" />
                <path d={`M154 ${y + boxH + gap - 12} L160 ${y + boxH + gap - 4} L166 ${y + boxH + gap - 12}`} fill="none" stroke="#1c1916" />
              </g>
            )}
          </g>
        );
      })
    }
  </svg>
  <figcaption>{caption}</figcaption>
</figure>
