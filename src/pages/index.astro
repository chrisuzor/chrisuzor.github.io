---
import Base from '../layouts/Base.astro';
import CaseStudyCards from '../components/CaseStudyCards.astro';
---

<Base
  title="Christopher Uzochukwu — Senior Backend & Platform Engineer"
  description="I build backend systems that remain reliable under load—from high-volume APIs and third-party integrations to distributed workflows and AI-assisted operational tools."
>
  <picture>
    <source srcset="/christopher-uzochukwu-portrait.webp" type="image/webp" />
    <img
      class="portrait"
      src="/christopher-uzochukwu-portrait-480.jpg"
      width="480"
      height="536"
      alt="Portrait of Christopher Uzochukwu"
    />
  </picture>
  <h1>Senior Backend &amp; Platform Engineer</h1>
  <p>
    I build backend systems that remain reliable under load—from high-volume APIs and third-party
    integrations to distributed workflows and AI-assisted operational tools.
  </p>
  <p class="meta">9+ years · Based in Nigeria · Remote worldwide · UTC+1</p>
  <ul class="actions">
    <li><a href="/case-studies/">View engineering work</a></li>
    <li><a href="/christopher-uzochukwu-cv-public.pdf">Download CV</a></li>
    <li><a href="/contact/">Contact me</a></li>
  </ul>
  <ul class="actions deck">
    <li><a href="/projects/">Projects</a></li>
    <li><a href="#experience">Experience</a></li>
    <li><a href="/case-studies/">Case studies</a></li>
    <li><a href="/open-source/">Open source</a></li>
    <li><a href="/cv/">Résumé</a></li>
    <li><a href="/contact/">Contact</a></li>
  </ul>
  <figure class="core">
    <figcaption>System core</figcaption>
    <div class="core-stage">
      <svg class="core-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <line x1="50" y1="48" x2="16" y2="16" />
        <line x1="50" y1="48" x2="84" y2="16" />
        <line x1="50" y1="48" x2="50" y2="84" />
      </svg>
      <p class="core-node">core</p>
      <ul>
        <li>API</li>
        <li>queue</li>
        <li>database</li>
      </ul>
    </div>
  </figure>
  <h2>Evidence</h2>
  <ul class="highlights">
    <li>500K+ daily API requests</li>
    <li>99.999% API uptime</li>
    <li>25+ production integrations</li>
    <li>1,000+ properties supported</li>
  </ul>
  <h2>Case studies</h2>
  <CaseStudyCards />
  <h2 id="experience">Experience</h2>
  <ul class="experience">
    <li>Yakili — Senior Backend Engineer</li>
    <li>
      Turing — AI Engineer (Part-time Contract) | May 2023–October 2025<br />
      Paid software-engineering AI training and model evaluation, including reviewing model-generated code, reproducing failures, validating solutions, and providing structured technical feedback.
    </li>
    <li>Mews — integrations and incident investigation</li>
    <li>Flexkeeping — high-volume APIs and testing</li>
    <li>Aardvark — Python microservices and AWS delivery</li>
    <li>OpenTeams — Django, data processing and Go</li>
    <li>JuiceServe — distributed EV-charging systems</li>
  </ul>
  <p><a href="/cv/">CV</a></p>
</Base>
