---
import '../styles/global.css';
import { COMMAND_NAMES } from '../lib/commands.js';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/case-studies/', label: 'Case Studies' },
  { href: '/projects/', label: 'Projects' },
  { href: '/writing/', label: 'Writing' },
  { href: '/open-source/', label: 'Open Source' },
  { href: '/cv/', label: 'CV' },
  { href: '/contact/', label: 'Contact' },
];

function current(href: string) {
  if (href === '/') return path === '/';
  const normalized = href.endsWith('/') ? href : `${href}/`;
  return path === href || path === href.replace(/\/$/, '') || path.startsWith(normalized);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.jpg', Astro.site)} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <a class="skip" href="#command">Skip to command</a>
    <p class="status">SYSTEM ONLINE · senior backend · Nigeria</p>
    <div class="shell">
      <header>
        <p class="site-name"><a href="/">Christopher Uzochukwu</a></p>
        <nav aria-label="Site">
          <ul>
            {
              links.map((link) => (
                <li>
                  <a href={link.href} aria-current={current(link.href) ? 'page' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>
      <section class="console" aria-labelledby="console-label">
        <p class="console-label" id="console-label">Command palette</p>
        <form id="command" action="#command">
          <label class="prompt" for="command-input">&gt;</label>
          <input id="command-input" name="command" autocomplete="off" spellcheck="false" placeholder="help" />
          <button type="submit">Run</button>
        </form>
        <ul class="suggestions">
          {
            COMMAND_NAMES.map((name) => (
              <li>
                <button type="button" data-command={name}>
                  {name}
                </button>
              </li>
            ))
          }
        </ul>
        <div class="console-log" id="command-log" aria-live="polite"></div>
      </section>
      <main id="content">
        <slot />
      </main>
      <footer>
        <p><a href="https://github.com/chrisuzor">GitHub</a> · <a href="https://www.linkedin.com/in/chris-uzor/">LinkedIn</a> · Abuja, Nigeria · GMT+1</p>
      </footer>
    </div>
    <script>
      import { parseCommand } from '../lib/commands.js';

      const form = document.querySelector<HTMLFormElement>('#command');
      const input = document.querySelector<HTMLInputElement>('#command-input');
      const log = document.querySelector<HTMLElement>('#command-log');
      if (form && input && log) {
        const paint = (echo: string, result: ReturnType<typeof parseCommand>) => {
          if (result.type === 'clear') {
            log.replaceChildren();
            return;
          }
          const entry = document.createElement('div');
          entry.className = 'console-entry';
          const echoed = document.createElement('p');
          echoed.className = 'console-echo';
          echoed.textContent = `> ${echo.trim()}`;
          entry.append(echoed);
          for (const line of result.lines) {
            const paragraph = document.createElement('p');
            paragraph.textContent = line;
            entry.append(paragraph);
          }
          if (result.links.length) {
            const list = document.createElement('ul');
            list.className = 'console-links';
            for (const link of result.links) {
              const item = document.createElement('li');
              const anchor = document.createElement('a');
              anchor.href = link.href;
              anchor.textContent = link.label;
              item.append(anchor);
              list.append(item);
            }
            entry.append(list);
          }
          log.replaceChildren(entry);
        };

        const run = (value: string) => {
          paint(value, parseCommand(value));
        };

        form.addEventListener('submit', (event) => {
          event.preventDefault();
          run(input.value);
          input.value = '';
        });

        input.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') input.blur();
        });

        for (const button of document.querySelectorAll<HTMLButtonElement>('[data-command]')) {
          button.addEventListener('click', () => {
            const name = button.dataset.command || '';
            input.value = name;
            run(name);
            input.focus();
          });
        }
      }
    </script>
  </body>
</html>
