---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/case-studies/incident-investigation/', label: 'Case study' },
  { href: '/repositories/', label: 'Repositories' },
  { href: '/cv/', label: 'CV' },
];

function current(href: string) {
  if (href === '/') return path === '/';
  return path === href || path === href.replace(/\/$/, '');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="frame">
      <header>
        <p class="site-name"><a href="/">Christopher Uzochukwu</a></p>
        <nav aria-label="Site">
          <ul>
            {
              links.map((link) => (
                <li>
                  <a href={link.href} aria-current={current(link.href) ? 'page' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>
      <main id="content">
        <slot />
      </main>
      <footer>
        <p><a href="https://github.com/chrisuzor">GitHub</a> · <a href="https://www.linkedin.com/in/chris-uzor/">LinkedIn</a> · Abuja, Nigeria · GMT+1</p>
      </footer>
    </div>
  </body>
</html>
